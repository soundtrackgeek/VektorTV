{
  "name": "vektortv",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "prepare:vlc": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-vlc.ps1",
    "bundle": "npm run prepare:vlc && tauri build --config src-tauri/tauri.bundle.conf.json --bundles nsis",
    "prepare:vlc:mac": "bash scripts/prepare-vlc-macos.sh",
    "bundle:windows": "npm run prepare:vlc && tauri build --config src-tauri/tauri.bundle.conf.json --bundles nsis",
    "bundle:mac": "npm run prepare:vlc:mac && tauri build --config src-tauri/tauri.bundle.conf.json --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
